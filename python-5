trips = [
    {"distance": 1.5, "hour": 14},
    {"distance": 5.0, "hour": 22},
    {"distance": 12.0, "hour": 3},
    {"distance": 8.5, "hour": 10},
    {"distance": 2.0, "hour": 23},
]

for trip in trips:
    distance = trip["distance"]
    hour = trip["hour"]

    fare = 150  # base fare for first 2 km

    if distance > 2:
        if distance <= 10:
            fare += (distance - 2) * 35
        else:
            fare += 8 * 35
            fare += (distance - 10) * 28

    # Night surcharge (10 PM - 5 AM)
    if hour >= 22 or hour < 5:
        fare += fare * 0.10

    print(f"Distance: {distance} km | Hour: {hour} -> Fare: NPR {round(fare, 2)}")