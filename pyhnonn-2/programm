# Function to add day suffix
def day_suffix(day):
    if 10 <= day <= 20:
        return "th"
    elif day % 10 == 1:
        return "st"
    elif day % 10 == 2:
        return "nd"
    elif day % 10 == 3:
        return "rd"
    else:
        return "th"


# Function to convert date
def convert_date(date_str, from_cal, to_cal):

    year, month, day = map(int, date_str.split("-"))

    if from_cal == to_cal:
        return date_str

    elif from_cal == "AD" and to_cal == "BS":
        year += 56

    elif from_cal == "BS" and to_cal == "AD":
        year -= 56

    return f"{year:04d}-{month:02d}-{day:02d}"


# Print formatted results
for customer in customers:
    converted = convert_date(customer["date"], customer["cal"], customer["need"])

    year, month, day = map(int, converted.split("-"))

    if customer["style"] == "iso":
        output = converted

    elif customer["style"] == "full":
        if customer["need"] == "BS":
            output = f"{day}{day_suffix(day)} {bs_months[month-1]}, {year} BS"
        else:
            output = f"{day}-{month:02d}-{year} AD"

    elif customer["style"] == "nepali":
        output = f"{day} {bs_months[month-1]} {year} BS"

    print(
        f'{customer["name"]} | Original: {customer["date"]} {customer["cal"]} | Converted: {output}'
    )













